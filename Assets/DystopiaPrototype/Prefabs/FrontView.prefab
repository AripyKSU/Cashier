  m_Text: "\uC2DC\uBBFC\uAD8C\uC744 \uC190\uC5D0 \uB123\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC774
    \uB9E4\uAE34 \uAC00\uACA9\uB4E4\uC774 \uC774\uACF3\uAE4C\uC9C0 \uB370\uB824\uC654\uC2B5\uB2C8\uB2E4.\n\n\uBA85\uC131\uACFC
