  - speaker: "\uC544\uBE60"
    body: "\uD558\uB8E8\uC57C, \uB610 \uB77C\uBA74 \uBA39\uAC8C \uD574\uC11C \uBBF8\uC548\uD574."
    revealOnStart: {fileID: 0}
  - speaker: "\uD558\uB8E8"
