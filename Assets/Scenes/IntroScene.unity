  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uAD1C\uCC2E\uC544\uC694. \uC774\uAC83\uB3C4 \uAC00\uC838\uAC00\uC138\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uC544\uBE60\uB294 \uC5B4\uB824\uC6B4 \uC0AC\uB78C\uC744 \uBCF4\uBA74
      \uADF8\uB0E5 \uC9C0\uB098\uCE58\uC9C8 \uBABB\uD574\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uB3C8\uC774 \uBAA8\uC790\uB77C\uB3C4 \uBB3C\uAC74\uC744 \uB354 \uCC59\uACA8\uC8FC\uACE0,
      \uC6B0\uB9AC\uAC00 \uC190\uD574\uB97C \uBD10\uB3C4 \uAD1C\uCC2E\uB2E4\uACE0
      \uD558\uC138\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uADF8\uB798\uC11C \uC6B0\uB9B0 \uD56D\uC0C1 \uAC00\uB09C\uD558\uC9C0\uB9CC\u2026
      \uC544\uBE60\uB294 \uC138\uC0C1\uC5D0\uC11C \uC81C\uC77C \uCC29\uD55C \uC0AC\uB78C\uC774\uC5D0\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Fade
    kind: 1
    index: 0
    speaker:
    text:
    seconds: 0.6
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Scene 03
    kind: 0
    index: 2
    speaker:
    text:
    seconds: 0
