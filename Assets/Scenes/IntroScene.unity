    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uC544\uBE60, \uB0B4\uAC00 \uB3C4\uC640\uC904\uAC8C\uC694!"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uBB34\uAC70\uC6CC, \uD558\uB8E8\uC57C. \uAC00\uB9CC\uD788 \uB450\uACE0
      \uC26C\uACE0 \uC788\uC5B4."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uC544\uBE60 \uD63C\uC790 \uD558\uBA74 \uD798\uB4E4\uC796\uC544\uC694.
      \uD558\uB8E8\uB3C4 \uB3C4\uC640\uC8FC\uACE0 \uC2F6\uC5B4\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uACE0\uB9D9\uB2E4, \uC6B0\uB9AC \uD558\uB8E8."
    seconds: 0
    value: 0
