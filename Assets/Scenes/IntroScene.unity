    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uC548\uB155\uD558\uC138\uC694. \uC81C \uC774\uB984\uC740 \uD558\uB8E8\uC5D0\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uD558\uB8E8"
    text: "\uC544\uBE60\uC640 \uC800\uB294 \uC804\uAD6D\uC744 \uB3CC\uC544\uB2E4\uB2C8\uBA70
      \uC7A5\uC0AC\uB97C \uD574\uC694."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Fade
    kind: 1
