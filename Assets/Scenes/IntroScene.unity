    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uC790\uB124, \uB9CC\uBB3C\uC0C1 \uCC28\uB7C9 \uB04C\uACE0 \uC5EC\uAE30\uC800\uAE30
      \uC7A5\uC0AC\uD558\uB7EC \uB2E4\uB2C8\uB358 \uC0AC\uB78C\uC774\uC9C0? \uBA87
      \uBC88 \uBCF8 \uC801 \uC788\uC5B4."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uB9C8\uCE68 \uBC30\uAE09\uC18C \uAC00\uD310 \uD558\uB098\uAC00 \uBE44\uC5C8\uB294\uB370\u2026
      \uD55C\uBC88 \uB9E1\uC544\uBCF4\uACA0\uB098?"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uB9E4\uC77C \uB0B4 \uBAAB\uB9CC \uBE60\uC9D0\uC5C6\uC774 \uAC00\uC838\uC640.
      \uB098\uBA38\uC9C0\uB294 \uC790\uB124\uAC00 \uC5BC\uB9C8\uB97C \uCC59\uAE30\uB4E0
      \uB208\uAC10\uC544\uC8FC\uC9C0."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\u2026\uADF8\uB7EC\uBA74 \uC544\uC774\uB97C \uCE58\uB8CC\uBC1B\uAC8C \uD560
      \uC218 \uC788\uC2B5\uB2C8\uAE4C?"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uB3C8\uBD80\uD130 \uB9C8\uB828\uD574."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uC2DC\uBBFC\uAD8C\uC774\uC57C \uC27D\uAC8C \uB098\uC624\uB294 \uBB3C\uAC74\uC740
      \uC544\uB2C8\uC9C0\uB9CC\u2026 \uB0B4\uAC00 \uC5EC\uAE30\uC800\uAE30 \uB3C8
      \uC880 \uCE60\uD558\uB2E4 \uBCF4\uBA74 \uAD6C\uD560 \uC218\uB3C4 \uC788\uC9C0."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Wait
    kind: 2
    index: 0
    speaker:
    text:
    seconds: 0.8
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\u2026\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uB0B4\uC77C \uC544\uCE68\uBD80\uD130 \uB098\uC640."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Wait
    kind: 2
    index: 0
    speaker:
    text:
    seconds: 0.8
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uB300\uC2E0, \uC9C0\uAE08\uCC98\uB7FC \uB0A8\uD55C\uD14C \uBCA0\uD480\uAE30\uB9CC
      \uD574\uC11C\uB294 \uB124 \uB538\uC740 \uC8FD\uC5B4."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: MusicLevel
    kind: 7
    index: 0
    speaker:
    text:
    seconds: 0.5
    value: 0.13
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uC88B\uC740 \uC0AC\uB78C\uC774 \uB420 \uAC74\uAC00, \uC544\uB2C8\uBA74
      \uC88B\uC740 \uC544\uBE60\uAC00 \uB420 \uAC74\uAC00?"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uAC10\uB3C5\uAD00"
    text: "\uC120\uD0DD\uC740 \uC790\uB124 \uBAAB\uC774\uC57C."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Wait
    kind: 2
    index: 0
    speaker:
    text:
    seconds: 1
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Fade
    kind: 1
    index: 0
    speaker:
    text:
    seconds: 1
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: StopAudio
    kind: 10
    index: 0
    speaker:
    text:
    seconds: 1
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Card
    kind: 9
    index: 0
    speaker:
    text: "1\uC77C \uCC28"
    seconds: 1.6
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
