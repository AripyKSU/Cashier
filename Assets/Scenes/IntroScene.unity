  - label: "CUT 2 - \uBCD1\uC6D0 \uC785\uAD6C"
    root: {fileID: 1998251009}
    useDialogueBox: 1
    lines:
    - speaker: "\uACBD\uBE44"
      body: "\uC2DC\uBBFC\uAD8C \uC5C6\uC774\uB294 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      revealOnStart: {fileID: 0}
    - speaker: "\uC544\uBE60"
      body: "\uC560\uAC00 \uC8FD\uC5B4\uAC00\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      revealOnStart: {fileID: 0}
    - speaker: "\uC758\uB8CC\uC9C4"
      body: "\uC9C0\uAE08 \uCE58\uB8CC\uD558\uC9C0 \uC54A\uC73C\uBA74\u2026 \uAE38\uC5B4\uC57C
        \uD55C \uB2EC\uC785\uB2C8\uB2E4."
      revealOnStart: {fileID: 0}
  - label: "CUT 3 - \uBCD1\uC6D0 \uBC16 / \uAC10\uB3C5\uAD00"
    root: {fileID: 1870781370}
    useDialogueBox: 1
    lines:
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uC0B4\uB9AC\uACE0 \uC2F6\uB098?"
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uC800 \uC548\uC5D0 \uB4E4\uC5B4\uAC08 \uC218\uB9CC \uC788\uB2E4\uBA74,
        \uC0B4\uB9B4 \uBC29\uBC95\uC740 \uC788\uC9C0."
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uD558\uC9C0\uB9CC \uB124 \uD798\uC73C\uB860 \uBD88\uAC00\uB2A5\uD574."
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uB0B4 \uBC11\uC5D0\uC11C \uC77C\uD574."
      revealOnStart: {fileID: 657652159}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uAC00\uD310 \uD558\uB098\uB294 \uB0B4\uC8FC\uC9C0."
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uBB3C\uAC74 \uAC12\uC740 \uB124\uAC00 \uC815\uD574."
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uC2DC\uD0A4\uB294 \uB9CC\uD07C \uBC8C\uC5B4\uC640."
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uADF8\uB7EC\uBA74 \uB124 \uB538\uC774 \uC0B4 \uC218 \uC788\uAC8C \uB0B4\uAC00
        \uC190\uC368\uC8FC\uC9C0."
      revealOnStart: {fileID: 0}
    - speaker: "\uAC10\uB3C5\uAD00"
      body: "\uC2DC\uAC04\uC740 \uB9CE\uC9C0 \uC54A\uC744 \uD150\uB370."
      revealOnStart: {fileID: 0}
  - label: "CUT 4 - \uC9D1 / \uB0A8\uC740 \uC2DC\uAC04"
    root: {fileID: 1526333676}
    useDialogueBox: 0
    lines: []
