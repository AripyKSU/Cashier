  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uBE44\uCF1C\uC8FC\uC138\uC694! \uC544\uC774\uAC00 \uC4F0\uB7EC\uC84C\uC5B4\uC694!"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uACBD\uBE44"
    text: "\uBA48\uCDB0! \uC2DC\uBBFC\uAD8C\uBD80\uD130 \uC81C\uC2DC\uD574."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uADF8\uB7F0 \uAC70 \uC5C6\uC2B5\uB2C8\uB2E4! \uC9C0\uAE08 \uC560\uAC00
      \uC758\uC2DD\uC774 \uC5C6\uB2E4\uACE0\uC694!"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uACBD\uBE44"
    text: "\uC2DC\uBBFC\uAD8C \uC5C6\uC73C\uBA74 \uBABB \uB4E4\uC5B4\uAC04\uB2E4.
      \uBB3C\uB7EC\uC11C."
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uADF8\uB7FC \uC758\uC0AC\uB77C\uB3C4 \uBD88\uB7EC! \uC560\uAC00 \uC8FD\uC5B4\uAC00\uB294\uB370
      \uBCF4\uACE0\uB9CC \uC788\uC744 \uAC70\uC57C?!"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uACBD\uBE44"
    text: "\uB9C8\uC9C0\uB9C9 \uACBD\uACE0\uB2E4. \uB354 \uB2E4\uAC00\uC624\uBA74\u2014"
    seconds: 0
    value: 0
    fadeMusic: 0
    musicTarget: 0.15
  - label: Line
    kind: 3
    index: 0
    speaker: "\uC544\uBE60"
    text: "\uBE44\uCF1C!! \uB0B4 \uB538\uBD80\uD130 \uC0B4\uB824\uC57C \uB41C\uB2E4\uACE0!!"
    seconds: 0
    value: 0
