      "text": "",
      "speaker": ""
    },
    {
      "label": "Vehicle reveal fanfare",
      "kind": 4,
      "index": 16,
      "seconds": 0,
      "value": 0.9,
      "text": "",
      "speaker": ""
    },
    {
      "label": "Proud reaction",
      "kind": 12,
