    {
      "label": "Line",
      "kind": 3,
      "index": 0,
      "seconds": 0,
      "value": 0,
      "text": "쯧쯧쯧… 그래서 딸내미 목숨을 살릴 수 있겠나?",
      "speaker": "감독관"
    },
    {
      "label": "Wait",
      "kind": 2,
