    {
      "label": "Line",
      "kind": 3,
      "index": 0,
      "seconds": 0,
      "value": 0,
      "text": "안녕하세요. 제 이름은 하루에요.",
      "speaker": "하루"
    },
    {
      "label": "Line",
      "kind": 3,
      "index": 0,
      "seconds": 0,
      "value": 0,
      "text": "아빠와 저는 전국을 돌아다니며 장사를 해요.",
      "speaker": "하루"
    },
    {
      "label": "Fade",
      "kind": 1,
      "index": 0,
      "seconds": 0.6,
      "value": 0,
      "text": "",
      "speaker": ""
    },
    {
      "label": "Scene 02",
      "kind": 0,
      "index": 1,
      "seconds": 0,
      "value": 0,
      "text": "",
      "speaker": ""
    },
    {
      "label": "Fade",
      "kind": 1,
      "index": 0,
      "seconds": 0.6,
