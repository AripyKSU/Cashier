    },
    {
      "idx": "8129",
      "text": "첫 만남"
    },
    {
      "idx": "8130",
      "text": "최종 목표"
    },
    {
      "idx": "8131",
      "text": "여기서 장사하고 싶다고 했지?"
    },
    {
      "idx": "8132",
      "text": "좋아. 자리는 내가 마련해줄게."
    },
    {
      "idx": "8133",
      "text": "대신 공짜는 없어. 정해진 때에 상납금을 가져와."
    },
    {
      "idx": "8134",
      "text": "못 맞추면?"
    },
    {
      "idx": "8135",
      "text": "뭐… 이 돈 내고 여기서 장사하고 싶어서 안달 난 사람은 많아."
    },
    {
      "idx": "8136",
      "text": "그중 한 명이 네 자리를 대신하겠지."
    },
    {
      "idx": "8137",
      "text": "그리고 네 딸 말이야."
    },
    {
      "idx": "8138",
      "text": "여기서는 치료받을 수 없잖아."
    },
    {
      "idx": "8139",
      "text": "안전구역 안으로 들어가면 제대로 된 병원이 있어."
    },
    {
      "idx": "8140",
      "text": "시민권만 있으면 말이지."
    },
    {
      "idx": "8141",
      "text": "원래 아무나 구할 수 있는 건 아닌데, 내가 위쪽에 아는 사람들이 좀 있어."
    },
    {
      "idx": "8142",
      "text": "물론 공짜는 아니야."
    },
    {
      "idx": "8143",
      "text": "여기저기 줄도 대야 하고, 여러 사람 섭섭하지 않게 해줘야 해서 돈이 엄청 들어."
    },
    {
      "idx": "8144",
      "text": "얼마냐고?"
    },
    {
      "idx": "8145",
      "text": "지금 당장은 말해줄 수 없어."
    },
    {
      "idx": "8146",
      "text": "네가 그 시민권을 살 수 있을 정도로 부자가 되면, 그때 가격을 알려주지."
    },
    {
      "idx": "8147",
      "text": "그러니까 악착같이 벌어."
    },
    {
      "idx": "8148",
      "text": "딸내미 데리고 안전구역 들어가서 치료받아야 할 거 아니야?"
    },
    {
      "idx": "8149",
      "text": "…그리고 이런 거 해주는 사람은 여기서 나밖에 없어."
    },
    {
      "idx": "8150",
      "text": "고마운 줄 알아."
    },
    {
      "idx": "8151",
      "text": "이야."
    },
    {
      "idx": "8152",
      "text": "여기 처음 왔을 때랑은 완전히 딴판이네."
    },
    {
      "idx": "8153",
      "text": "솔직히 말해서 네가 여기까지 올 줄은 몰랐어."
    },
    {
      "idx": "8154",
      "text": "축하해."
    },
    {
      "idx": "8155",
      "text": "이제야 그 얘기를 해줄 만하겠네."
    },
    {
      "idx": "8156",
      "text": "처음에 내가 말했지?"
    },
    {
      "idx": "8157",
      "text": "돈 좀 모으면 안전구역 시민권 구해줄 수 있다고."
    },
    {
      "idx": "8158",
      "text": "내가 위쪽에 사람들한테 줄 좀 대고 알아봤어."
    },
    {
      "idx": "8159",
      "text": "원래 시민권이 한 명당 3억이야."
    },
    {
      "idx": "8160",
      "text": "너랑 딸내미, 둘이면 6억이지."
    },
    {
      "idx": "8161",
      "text": "근데 말이야…"
    },
    {
      "idx": "8162",
      "text": "우리가 그래도 하루 이틀 본 사이도 아니고."
    },
    {
      "idx": "8163",
      "text": "그동안 너 장사하는 것도 내가 계속 봐왔잖아."
    },
    {
      "idx": "8164",
      "text": "나도 사람인데, 어떻게 원래 가격을 다 받겠어."
    },
    {
      "idx": "8165",
      "text": "그래서 내가 위쪽 사람들한테 사정도 좀 하고, 여기저기 내 몫도 좀 줄여가면서 얘기를 맞춰봤지."
    },
    {
      "idx": "8166",
      "text": "특별히."
    },
    {
      "idx": "8167",
      "text": "딱 5억만 받기로 했어."
    },
    {
      "idx": "8168",
      "text": "1억이나 깎아준 거야."
    },
    {
      "idx": "8169",
      "text": "5억만 가져오면 시민권은 내가 어떻게든 구해줄게."
    },
    {
      "idx": "8170",
      "text": "그러면 너도 딸내미 데리고 안전구역으로 들어갈 수 있고."
    },
    {
      "idx": "8171",
      "text": "거기 병원에서 치료도 받을 수 있겠지."
    },
    {
      "idx": "8172",
      "text": "…아, 그리고."
    },
    {
      "idx": "8173",
      "text": "가게도 이만큼 커졌는데 예전이랑 같은 상납금을 받을 순 없잖아?"
    },
    {
      "idx": "8174",
      "text": "다음부터는 좀 올릴 거야."
    },
    {
      "idx": "8175",
      "text": "뭐, 이제 너 정도면 그 정도는 충분히 벌잖아?"
    },
    {
      "idx": "8176",
      "text": "열심히 해."
    },
    {
      "idx": "8177",
      "text": "아픈 딸내미는 하루하루 더 죽어가고 있는데…"
    },
    {
      "idx": "8178",
      "text": "설마 이대로 보고만 있을 건 아니지?"
    },
    {
      "idx": "8179",
      "text": "…넌 아빠잖아."
    },
    {
      "idx": "8180",
      "text": "2일차 등장 확인"
    },
    {
      "idx": "8181",
      "text": "2일차 감독관 등장 확인용 임시 대사입니다."
    },
    {
      "idx": "8182",
      "text": "가난"
    },
    {
      "idx": "8183",
      "text": "아빠랑 있으면 자꾸 겁이 나."
    },
    {
      "idx": "8184",
      "text": "오늘은 아빠와 이야기하고 싶지 않아."
    },
    {
      "idx": "8185",
      "text": "예전의 아빠가 그리워."
    },
    {
      "idx": "8186",
      "text": "요즘 아빠가 조금 낯설어."
    },
    {
      "idx": "8187",
      "text": "아빠 표정이 자꾸 걱정돼."
    },
    {
      "idx": "8188",
      "text": "나한테는 솔직하게 말해줘."
    },
    {
      "idx": "8189",
      "text": "오늘 많이 힘들었어?"
    },
    {
      "idx": "8190",
      "text": "무슨 일 있었어?"
    },
    {
      "idx": "8191",
      "text": "잠깐 내 옆에 있어줄래?"
    },
    {
      "idx": "8192",
      "text": "아빠, 오늘도 다녀왔네."
    },
    {
      "idx": "8193",
      "text": "오늘 하루는 어땠어?"
    },
    {
      "idx": "8194",
      "text": "잠깐 같이 이야기할래?"
    },
    {
      "idx": "8195",
      "text": "아빠랑 이야기하면 마음이 놓여."
    },
    {
      "idx": "8196",
      "text": "아빠가 웃으니까 나도 좋아."
    },
    {
      "idx": "8197",
      "text": "오늘은 조금 안심이 돼."
    },
    {
      "idx": "8198",
      "text": "나는 아빠를 믿어."
    },
    {
      "idx": "8199",
      "text": "아빠가 있어서 든든해."
    },
    {
      "idx": "8200",
      "text": "내일도 아빠랑 함께 있고 싶어."
    },
    {
      "idx": "8201",
      "text": "야간 투시경"
    },
    {
      "idx": "8202",
      "text": "휴대용 탐지기"
    },
    {
      "idx": "8203",
      "text": "생각보다 저렴하네요. 이대로 계산해 주세요."
    },
    {
      "idx": "8204",
      "text": "가격이 괜찮네요. 잘 사 가겠습니다."
    },
    {
      "idx": "8205",
      "text": "조금 비싸지만 이 정도는 낼게요."
    },
    {
      "idx": "8206",
      "text": "예상보다 높네요. 그래도 구매하겠습니다."
    },
    {
      "idx": "8207",
      "text": "가격까지 낮춰 주셨네요. 바로 계산해 주세요."
    },
    {
      "idx": "8208",
      "text": "다행이네요. 이대로 빨리 가져갈게요."
    },
    {
      "idx": "8209",
      "text": "비싸지만 지금은 필요해요. 바로 살게요."
    },
    {
      "idx": "8210",
      "text": "부담되지만 더 기다릴 수 없어요. 계산해 주세요."
    },
    {
      "idx": "8211",
      "text": "필요한 물건을 넉넉히 살펴보려고요."
    },
    {
      "idx": "8212",
      "text": "준비해 둘 물품을 보러 왔습니다."
    },
    {
      "idx": "8213",
      "text": "적정한 가격이네요. 이대로 계산해 주세요."
    },
    {
      "idx": "8214",
      "text": "가격을 확인했습니다. 구매하겠습니다."
    },
    {
      "idx": "8215",
      "text": "좋은 가격이네요. 예산에 여유가 생겼어요."
    },
    {
      "idx": "8216",
      "text": "예상보다 저렴하군요. 이대로 구매하겠습니다."
    },
    {
      "idx": "8217",
      "text": "가격이 높지만 필요한 물건이라 사겠습니다."
    },
    {
      "idx": "8218",
      "text": "평소보다 비싸군요. 그래도 준비해 두죠."
    },
    {
      "idx": "8219",
      "text": "그만한 값을 치를 물건은 아닌 것 같군요."
    },
    {
      "idx": "8220",
      "text": "가격 차이가 지나칩니다. 이번에는 사지 않겠습니다."
    },
    {
      "idx": "8221",
      "text": "필요한 것부터 맞춰 보려고요."
    },
    {
      "idx": "8222",
      "text": "예산 안에서 살 수 있는지 확인해 볼게요."
    },
    {
      "idx": "8223",
      "text": "계산해 본 범위 안이네요. 구매할게요."
    },
    {
      "idx": "8224",
      "text": "이 가격이면 계획대로 살 수 있겠어요."
    },
    {
      "idx": "8225",
      "text": "가격이 낮아져서 다행이에요. 이대로 살게요."
    },
    {
      "idx": "8226",
      "text": "덕분에 필요한 물건을 챙길 수 있겠네요."
    },
    {
      "idx": "8227",
      "text": "부담되지만 꼭 필요한 물건이라 살게요."
    },
    {
      "idx": "8228",
      "text": "예산이 빠듯해지겠지만 이번에는 구매할게요."
    },
    {
      "idx": "8229",
      "text": "이 가격까지는 감당하기 어렵습니다."
    },
    {
      "idx": "8230",
      "text": "예산을 넘어서네요. 오늘은 포기할게요."
    }
  ]
}