  "TextData": [
    {
      "idx": "8183",
      "text": "아빠가 조금 낯설게 느껴져."
    },
    {
      "idx": "8184",
      "text": "오늘은 혼자 있고 싶어."
    },
    {
      "idx": "8185",
      "text": "예전처럼 웃어주면 안 돼?"
    },
    {
      "idx": "8186",
      "text": "아빠, 무슨 일 있었어?"
    },
    {
      "idx": "8187",
      "text": "요즘은 아빠 표정이 무서워."
    },
    {
      "idx": "8188",
      "text": "나한테는 솔직하게 말해줘."
    },
    {
      "idx": "8189",
      "text": "오늘 많이 힘들었어?"
    },
    {
      "idx": "8190",
      "text": "아빠가 걱정돼."
    },
    {
      "idx": "8191",
      "text": "잠깐만 내 옆에 있어줘."
    },
    {
      "idx": "8192",
      "text": "아빠, 오늘도 다녀왔네."
    },
    {
      "idx": "8193",
      "text": "같이 조금만 이야기하자."
    },
    {
      "idx": "8194",
      "text": "오늘 하루는 어땠어?"
    },
    {
      "idx": "8195",
      "text": "아빠랑 이야기하면 마음이 편해."
    },
    {
      "idx": "8196",
      "text": "오늘은 좋은 꿈을 꿀 것 같아."
    },
    {
      "idx": "8197",
      "text": "아빠가 웃어서 나도 좋아."
    },
    {
      "idx": "8198",
      "text": "나는 아빠가 자랑스러워."
    },
    {
      "idx": "8199",
      "text": "내일도 아빠랑 함께하고 싶어."
    },
    {
      "idx": "8200",
      "text": "아빠 덕분에 오늘은 덜 무서웠어."
    }
  ],
